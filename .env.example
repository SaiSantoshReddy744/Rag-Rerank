# Copy this file to ".env" in the project root and fill in your OpenAI API key and model.
# Create an API key in the OpenAI API dashboard. Never commit .env or paste the key into chat.
OPENAI_API_KEY=
# Example only; choose a model available to your API project.
OPENAI_MODEL=gpt-6-astra

# --- Optional (defaults shown) ---
# Leave QDRANT_URL empty to use the embedded on-disk vector DB (no Docker needed).
# QDRANT_URL=http://localhost:6333
# RE_RANK_ENABLED=true
# RE_RANK_MODEL_NAME=BAAI/bge-reranker-base
# RERANK_CANDIDATE_K=20
